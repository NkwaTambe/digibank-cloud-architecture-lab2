# Copy this file to `.env` and adjust the values for your environment.
# The `.env` file is git-ignored and never committed, so it is not scanned by
# secret-detection tools. Docker Compose reads it automatically from the
# directory containing `docker-compose.yml` and injects the values as the
# DB_USERNAME / DB_PASSWORD environment variables used by the databases and
# every microservice.
DB_USERNAME=
DB_PASSWORD=
